generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id          String   @id @default(uuid()) @db.Uuid
  displayName String
  email       String?  @unique
  createdAt   DateTime @default(now())

  progression           PlayerProgression?
  loadout               PlayerLoadout?
  items                 PlayerItem[]
  sessions              Session[]
  emailVerifiationCodes EmailVerificationCode[]
  sentFriendInvites     FriendInvite[]
  friendshipsA          Friendship[]            @relation("FriendshipPlayerA")
  friendshipsB          Friendship[]            @relation("FriendshipPlayerB")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  playerId         String    @db.Uuid
  refreshTokenHash String    @unique
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

model EmailVerificationCode {
  id        String    @id @default(uuid()) @db.Uuid
  playerId  String    @db.Uuid
  email     String
  codeHash  String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
}

model SignupVerificationCode {
  id          String    @id @default(uuid()) @db.Uuid
  displayName String
  email       String
  codeHash    String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  usedAt      DateTime?

  @@index([email, createdAt])
}

model PlayerProgression {
  playerId                String    @id @db.Uuid
  trophies                Int       @default(0)
  highestTrophies         Int       @default(0)
  coins                   Int       @default(0)
  gems                    Int       @default(0)
  chestProgress           Int       @default(0)
  introChestsOpened       Int       @default(0)
  dailyBonusWinsRemaining Int       @default(0)
  nextDailyBonusAt        DateTime?

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([trophies(sort: Desc)])
}

model PlayerLoadout {
  playerId  String @id @db.Uuid
  rangedId  String
  meleeId   String
  armourId  String
  abilityId String
  styleId   String

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model PlayerItem {
  playerId   String   @db.Uuid
  itemId     String
  unlockedAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, itemId])
}

model Friendship {
  id        String   @id @default(uuid()) @db.Uuid
  playerAId String   @db.Uuid
  playerBId String   @db.Uuid
  createdAt DateTime @default(now())

  playerA Player @relation("FriendshipPlayerA", fields: [playerAId], references: [id], onDelete: Cascade)
  playerB Player @relation("FriendshipPlayerB", fields: [playerBId], references: [id], onDelete: Cascade)

  @@unique([playerAId, playerBId])
  @@index([playerBId])
}

model FriendInvite {
  id        String   @id @default(uuid()) @db.Uuid
  inviterId String   @db.Uuid
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  inviter Player @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId])
  @@index([expiresAt])
}
